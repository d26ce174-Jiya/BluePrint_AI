# Compile / BlueprintAI Backend Environment Template
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your-secure-random-jwt-secret-key-here
JWT_EXPIRES_IN=10d

# MySQL Database (XAMPP / MySQL Server defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=compile_db

# ==============================================================================
# MULTI-LLM PROVIDER CONFIGURATION
# ==============================================================================
# Active LLM Provider Selection:
# Options: auto | openai | anthropic | gemini | groq | deepseek | ollama
# 'auto' automatically selects the first provider that has an API key configured.
LLM_PROVIDER=auto

# Global Temperature (0.0 = deterministic/precise, 1.0 = creative)
LLM_TEMPERATURE=0.2

# Fallback to smart heuristic reasoning engine if API calls fail or keys are empty
FALLBACK_TO_HEURISTICS=true

# ------------------------------------------------------------------------------
# 1. OpenAI (GPT-4o, GPT-4o-mini, o1, etc.)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 2. Anthropic Claude (Claude 3.5 Sonnet, Claude 3 Opus, Claude 3.5 Haiku)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
LLM_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 3. Google Gemini (Gemini 1.5 Pro, Gemini 1.5 Flash, Gemini 2.0 Flash)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 4. Groq (Ultra-low latency Llama 3.3, Mixtral)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 5. DeepSeek (DeepSeek-V3 / DeepSeek-R1)
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ------------------------------------------------------------------------------
# 6. Ollama (Local & Private Self-Hosted Models)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
